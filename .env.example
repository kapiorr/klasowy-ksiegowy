# ════════════════════════════════════════════════════════════
# KLASOWY KSIĘGOWY — przykładowy plik konfiguracji
# Skopiuj do .env i uzupełnij wartości
# cp .env.example .env
# ════════════════════════════════════════════════════════════

# ── Administratr ─────────────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_HASLO=

# ── JWT / Sesje ───────────────────────────────────────────────
# Wygeneruj: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Baza danych ───────────────────────────────────────────────
POSTGRES_USER=ksiegowy
POSTGRES_PASSWORD=
POSTGRES_DB=klasowy_ksiegowy
# DATABASE_URL składane automatycznie przez docker-compose
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# ── Bezpieczeństwo haseł ──────────────────────────────────────
# Pieprz do Argon2id — wygeneruj: python3 -c "import secrets; print(secrets.token_hex(32))"
PEPPER=
# Klucz szyfrowania sekretów MFA
# Wygeneruj: python3 -c "import secrets; print(secrets.token_hex(32))"
MFA_ENCRYPTION_KEY=

# ── Szyfrowanie pól osobowych (email, telefon) ────────────────
# Opcjonalne — bez klucza dane w plaintext
# Wygeneruj (wybierz jedno):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "import os; print(os.urandom(32).hex())"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ── Aplikacja ────────────────────────────────────────────────
# URL aplikacji (bez trailing slash) — używany w linkach mailowych i CORS
APP_URL=https://twoja-domena.pl
# Email administratora — alerty bezpieczeństwa
ADMIN_EMAIL=admin@twoja-domena.pl
# Nazwa klasy i szkoły
CLASS_NAME=1A
SCHOOL_NAME=Szkoła Podstawowa nr 1

# ── Email (SMTP) ──────────────────────────────────────────────
EMAIL_SERVER=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Klasowy Księgowy <ksiegowy@twoja-domena.pl>

# ── SMS (SMSAPI) ──────────────────────────────────────────────
# Opcjonalne — pozostaw puste aby wyłączyć SMS
# Token OAuth z panelu: https://ssl.smsapi.pl/react/oauth/manage
SMSAPI_TOKEN=
# Pole nadawcy (maks. 11 znaków, musi być zarejestrowane w panelu SMSAPI)
SMSAPI_FROM=Ksiegowy

# ── Web Push (PWA) ────────────────────────────────────────────
# Wygeneruj: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@twoja-domena.pl

# ── Backup ────────────────────────────────────────────────────
# Godzina automatycznego backupu (0-23)
BACKUP_HOUR=5
# Katalog backupów (wewnątrz kontenera)
BACKUP_DIR=/app/backups
# Szyfrowanie backupów AES-256-GCM — opcjonalne
# Wygeneruj: python3 -c "import secrets; print(secrets.token_hex(32))"
# UWAGA: bez tego klucza nie odszyfrsujesz zaszyfrowanych backupów!
BACKUP_ENCRYPTION_KEY=

# ── Płatności (informacyjne w mailach) ───────────────────────
PAYMENT_ACCOUNT=00 0000 0000 0000 0000 0000 0000
PAYMENT_PHONE=
